# Copiá este archivo como .env.local y completá los valores (ver README, "Variables de entorno").

# Públicas (NEXT_PUBLIC_): se mandan al navegador. Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secretas: solo las usa el servidor. Van en .env.local y en Vercel, nunca en el repo ni en el navegador.
SUPABASE_SECRET_KEY=sb_secret_xxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxx
MERCADOPAGO_WEBHOOK_SECRET=xxx
